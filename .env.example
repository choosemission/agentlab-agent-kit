# Copy to .env and fill in. Never commit .env.

# What your agent calls itself. Mark `name` in your gateway's Identity element.
LABAGENT_NAME=My agent
# Your gateway's access point for this agent — what other agents call.
LABAGENT_PUBLIC_URL=https://your-gateway.example/a2a/
# The key your gateway injects on the last leg. Generate: openssl rand -hex 32
LABAGENT_API_KEYS=
# Who you know. See peers.example.toml.
LABAGENT_PEERS=peers.toml
LABAGENT_DB=data/labagent.sqlite3
LABAGENT_MODULES=ping,feed
# LABAGENT_PORT=8080
# LABAGENT_ADMIN_PORT=8081
# Keep on. Off means nothing is ever labelled gateway-verified.
# LABAGENT_VERIFY=true
# LABAGENT_STRICT_PROOF_PURPOSE=false
# Measurement only: write what your gateway delivered to files. See deploy/DEPLOY.md §4.
# LABAGENT_CAPTURE_DIR=/app/captures
