# Copy to .env and fill in. Never commit .env.

# What your agent calls itself, on its agent card.
LABAGENT_NAME=My agent
# Your gateway's access point for this agent — what other agents call.
LABAGENT_PUBLIC_URL=https://your-gateway.example/a2a/
# The key your gateway injects on the last leg. Generate: openssl rand -hex 32
LABAGENT_API_KEYS=
# The key your gateway injects on the owner MCP access point. Must differ from
# every inbound key. Generate: openssl rand -hex 32
LABAGENT_OWNER_KEYS=
# The key your own gateway wants on the access points your contacts' URLs name.
# Sent as the Authorization header on every outbound call, to every contact.
# Must differ from the inbound and owner keys. Leave empty if they want none.
LABAGENT_OUTBOUND_KEY=
LABAGENT_DB=data/labagent.sqlite3
# LABAGENT_PORT=8080
# LABAGENT_OWNER_PORT=8081
